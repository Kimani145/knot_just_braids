# ==============================================================================
# Knot Just Braids - Environment Configuration Template
# All secrets and API credentials must be set in your private .env file or host console.
# NEVER commit real credentials, tokens, or private keys to source control.
# ==============================================================================

# Client-Side Cloudinary (Media Assets)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Client-Side Firebase SDK
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Client-Side EmailJS (Order & Booking Confirmations)
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_MASTER_TEMPLATE=your_emailjs_template_id

# Feature Flags & API Configuration
VITE_USE_API_CHECKOUT=false
VITE_API_BASE_URL=

# Observability & Analytics
VITE_ANALYTICS_PROVIDER=none
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_SENTRY_DSN=

# ==============================================================================
# Server-Side Environment Variables (Vercel Functions / Backend Service)
# Never prefix server-only secrets with VITE_
# ==============================================================================

# Firebase Admin SDK (Base64-encoded Service Account JSON)
FIREBASE_SERVICE_ACCOUNT_KEY=

# Admin User UIDs (Comma-separated Firebase Auth UIDs allowed write access)
ADMIN_UIDS=

# Cloudinary Server Credentials (for Signed Uploads and Destroy API)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS and Security
ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.vercel.app
APPCHECK_ENFORCE=false

# WhatsApp Cloud API (v1 / Planned)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
